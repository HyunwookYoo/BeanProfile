  "original": [
    {"text":"에티오피아","l":141.0,"t":722.0,"r":828.0,"b":885.0,"conf":0.780468761920929},
    {"text":"벤치마지 게샤","l":161.0,"t":922.0,"r":1000.0,"b":1086.0,"conf":0.7298176884651184},
    {"text":"게이샤 품종의 기원지로 알려진 에티오피아 남서부 벤치마지 지역의","l":118.0,"t":1366.0,"r":1991.0,"b":1445.0,"conf":0.7892020344734192},
    {"text":"깊은 숲 속, 고리 게샤 숲(Gori Gesha Forest) 인근에 자리한","l":161.0,"t":1470.0,"r":1894.0,"b":1551.0,"conf":0.7924952507019043},
    {"text":"게샤 카르마치 농장(Gesha Karmach Farm)은 2019년에","l":125.0,"t":1559.0,"r":1846.0,"b":1645.0,"conf":0.8110795617103577},
    {"text":"설립된 비교적 젊은 농장입니다. 이 농장은 게샤 마을에서 불과","l":125.0,"t":1653.0,"r":1911.0,"b":1740.0,"conf":0.7759915590286255},
    {"text":"5km 떨어진 고산지대에 위치해 있으며, 전통적인 토양, 강수량,","l":164.0,"t":1759.0,"r":1939.0,"b":1838.0,"conf":0.7535021305084229},
    {"text":"고도 조건이 게이샤의 원산지와 매우 유사합니다.","l":125.0,"t":1846.0,"r":1536.0,"b":1933.0,"conf":0.7790178656578064},
    {"text":"총 1,000해헥타르에 달하는 농장 중 350헥타르가 커피 재배지로","l":122.0,"t":1945.0,"r":1936.0,"b":2028.0,"conf":0.7503906488418579},
    {"text":"활용되고 있습니다. 농장 동쪽 경계를 따라 오모강이 흐르며, 이","l":160.0,"t":2047.0,"r":1922.0,"b":2134.0,"conf":0.7925347089767456},
    {"text":"지역의 물, 숲, 토양이 어우러져 독특한 떼루아를 형성하고","l":161.0,"t":2134.0,"r":1795.0,"b":2224.0,"conf":0.785937488079071},
    {"text":"있습니다. 카르마치 농장은 벤치마지 지역의 원시림과 공생하는","l":121.0,"t":2223.0,"r":1943.0,"b":2323.0,"conf":0.8336226940155029},
    {"text":"재생 농업(regenerative agricuture)을 지향합니다.","l":159.0,"t":2334.0,"r":1662.0,"b":2419.0,"conf":0.7705357074737549},
    {"text":"자연스럽게 형성된 음영림이 커피니무를 보호하고, 토양의 영양과","l":121.0,"t":2416.0,"r":2006.0,"b":2517.0,"conf":0.8111048936843872},
    {"text":"병충해 저항성을 높이는 생태적 시스템을 구축해 건강한 커피를","l":161.0,"t":2524.0,"r":1935.0,"b":2608.0,"conf":0.7663761973381042},
    {"text":"생산하고 있습니다.","l":159.0,"t":2612.0,"r":678.0,"b":2692.0,"conf":0.7873263955116272},
    {"text":"프로세스","l":157.0,"t":3098.0,"r":424.0,"b":3178.0,"conf":0.755859375},
    {"text":"품종","l":158.0,"t":3208.0,"r":288.0,"b":3277.0,"conf":0.54296875},
    {"text":"고도","l":157.0,"t":3313.0,"r":288.0,"b":3372.0,"conf":0.66796875},
    {"text":"WASHED","l":559.0,"t":3116.0,"r":871.0,"b":3177.0,"conf":0.8802083134651184},
    {"text":"GESHA","l":558.0,"t":3216.0,"r":799.0,"b":3276.0,"conf":0.901562511920929},
    {"text":"1,800m","l":557.0,"t":3315.0,"r":809.0,"b":3393.0,"conf":0.7962239384651184},
    {"text":"로스팅","l":1495.0,"t":3125.0,"r":1690.0,"b":3196.0,"conf":0.80859375},
    {"text":"컵노트","l":1495.0,"t":3221.0,"r":1690.0,"b":3293.0,"conf":0.64453125},
    {"text":"LIGHT","l":1818.0,"t":3133.0,"r":2032.0,"b":3193.0,"conf":0.80859375},
    {"text":"오렌지블라썸, 자스민, 살구.","l":1816.0,"t":3222.0,"r":2663.0,"b":3311.0,"conf":0.5934709906578064},
    {"text":"베르가못, 녹차","l":1816.0,"t":3325.0,"r":2262.0,"b":3415.0,"conf":0.6662946343421936}
