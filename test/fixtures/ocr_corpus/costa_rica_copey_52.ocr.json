    {"text":"코스타 리카하시엔다 코페이 돈 카주 레드 카투아이","l":641.0,"t":763.0,"r":2309.0,"b":862.0,"conf":0.843563973903656},
    {"text":"무산소 내추럴 #52","l":641.0,"t":899.0,"r":1252.0,"b":979.0,"conf":0.7907986044883728},
    {"text":"지역: Copey , Dota","l":614.0,"t":1161.0,"r":1411.0,"b":1282.0,"conf":0.73828125},
    {"text":"농장: Hacienda Copey 고도: 1900m","l":648.0,"t":1331.0,"r":2190.0,"b":1437.0,"conf":0.6834309697151184},
    {"text":"로트: Don Kazu #52 품종: Red Catuci","l":650.0,"t":1491.0,"r":2246.0,"b":1582.0,"conf":0.6993749737739563},
    {"text":"프로세스: Anaerobic Naturoal","l":649.0,"t":1636.0,"r":1826.0,"b":1742.0,"conf":0.6637073755264282},
    {"text":"럼 레이즌. 포도 사탕. 자두. 카카오닙스","l":653.0,"t":2000.0,"r":2064.0,"b":2102.0,"conf":0.6608073115348816},
    {"text":"완전히 익은 체리를 선별하여 수확한 뒤, 산소를","l":631.0,"t":2353.0,"r":2209.0,"b":2457.0,"conf":0.8031250238418579},
    {"text":"차단한 스테인리스 스틸 탱크에서 약 120시간 동안","l":662.0,"t":2486.0,"r":2331.0,"b":2585.0,"conf":0.8702059388160706},
    {"text":"혐기성 발효를 진행한다. 이 과정에서 미생물은 체리","l":626.0,"t":2607.0,"r":2348.0,"b":2715.0,"conf":0.8348721861839294},
    {"text":"내부의 당분을 천천히 분해하며 복합적인 향과 맛의","l":626.0,"t":2736.0,"r":2332.0,"b":2845.0,"conf":0.8922991156578064},
    {"text":"토대를 만들어내고, 이는 컵 프로파일에 깊이 있는","l":622.0,"t":2863.0,"r":2269.0,"b":2976.0,"conf":0.843377947807312},
    {"text":"단맛과 복합적인 과일 향을 더한다. 발효가 완료된","l":637.0,"t":2993.0,"r":2260.0,"b":3105.0,"conf":0.8495163917541504},
    {"text":"체리는 탱크에서 꺼내어 아프리칸 베드에서 약19일간","l":668.0,"t":3121.0,"r":2390.0,"b":3228.0,"conf":0.8413723111152649},
    {"text":"천천히 건조한다. 이 느린 건조 과정은 과육에서","l":649.0,"t":3239.0,"r":2173.0,"b":3358.0,"conf":0.804882824420929},
    {"text":"생두로 향미가 충분히 스며들도록 도와주며, 구조감이","l":674.0,"t":3371.0,"r":2362.0,"b":3483.0,"conf":0.8026494383811951},
    {"text":"단단하고 안정적인 컵 밸런스를 만들어낸다.","l":679.0,"t":3496.0,"r":2063.0,"b":3605.0,"conf":0.8057154417037964}
