  "original": [
    {"text":"• NAME OF FARM: Sol de La Mañana","l":125.0,"t":865.0,"r":1538.0,"b":960.0,"conf":0.7834374904632568},
    {"text":"볼리비아 커피를 다시 살리고자 Agricafe의 Rodriguez 가족들이 시작한","l":95.0,"t":997.0,"r":2649.0,"b":1116.0,"conf":0.7927631735801697},
    {"text":"프로그램으로 1990년대 병총해 때문에 카라나비 전체의 커피 생산 문제를","l":99.0,"t":1149.0,"r":2714.0,"b":1257.0,"conf":0.8099365234375},
    {"text":"농가들과 함께 커피를 다시 지속가능한 방식으로 이어갈 수 있는 프로젝트입니다","l":101.0,"t":1291.0,"r":2943.0,"b":1405.0,"conf":0.8351088762283325},
    {"text":"• REGION: Caranavi","l":133.0,"t":1462.0,"r":863.0,"b":1545.0,"conf":0.800537109375},
    {"text":"• PRODUCER: Carmelita & Luis Choguehuanca","l":154.0,"t":1594.0,"r":1900.0,"b":1681.0,"conf":0.8337673544883728},
    {"text":"• ALTITUDE: 1,600 masl","l":140.0,"t":1748.0,"r":1020.0,"b":1826.0,"conf":0.7756990194320679},
    {"text":"• VARIETAL: Caturra","l":141.0,"t":1882.0,"r":872.0,"b":1960.0,"conf":0.7444853186607361},
    {"text":"• PROCESS: Coco Natural","l":163.0,"t":2025.0,"r":1070.0,"b":2103.0,"conf":0.759960949420929},
    {"text":"Agricafe,로드리게스 패밀리가 발전시킨 시그니처 가공명으로,","l":113.0,"t":2162.0,"r":2265.0,"b":2253.0,"conf":0.7843017578125},
    {"text":"체리를 과육째 유지한 채 말리되, 일반 내추럴보다 건조 환경을 훨씬더","l":125.0,"t":2299.0,"r":2561.0,"b":2393.0,"conf":0.7751885652542114},
    {"text":"정밀하게 제어하는 방식에 있습니다. \"Coco0'는 코코넛이 아니라 cocoa건조","l":129.0,"t":2433.0,"r":2706.0,"b":2523.0,"conf":0.7091899514198303},
    {"text":"기술에서 가져온 것입니다.","l":86.0,"t":2567.0,"r":1006.0,"b":2665.0,"conf":0.7796223759651184},
    {"text":".FLAVOR : 열대과일과 엘로우 피치의 밝고 선명한 산미를 시작으로,","l":156.0,"t":2852.0,"r":2485.0,"b":2949.0,"conf":0.72412109375},
    {"text":"말차가 생각나는 플레이버와 머스켓이 떠오르는 플로럴함,","l":534.0,"t":2992.0,"r":2519.0,"b":3085.0,"conf":0.7537500262260437},
    {"text":"코코아를 연상시키는 부드러운 단맛과 질감이 더해진","l":558.0,"t":3133.0,"r":2349.0,"b":3216.0,"conf":0.8220880627632141},
    {"text":"화사하면서도 밀도감 있는 커피입니다.","l":583.0,"t":3265.0,"r":1880.0,"b":3357.0,"conf":0.8035386204719543}
  ],
